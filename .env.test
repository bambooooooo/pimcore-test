# Test environment (APP_ENV=test). Loaded after .env; real secrets never belong here.
# Pimcore product registration for tests goes to .env.test.local (bin/run-tests copies it from .env.local).

PIMCORE_TEST_DB_DSN=mysql://pimcore:pimcore@test_db:3306/pimcore_test?serverVersion=10.11.11-MariaDB

# Integrations get dummy endpoints - tests must never reach real services
APP_DOMAIN=pim.test
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_ASSET_HOST=http://nginx:80
GS1_USERNAME=test
GS1_PASSWORD=test
MQ_HOST=localhost
MQ_PORT=5672
MQ_VHOST=test
MQ_USER=test
MQ_PWD=test
DEEPL_APIKEY=test:fx
DEEPL_DOM_RENEW=0
SGT_HOST=sgt.invalid
SGT_PORT=1
ALLEGRO_CLIENT_ID=test
ALLEGRO_CLIENT_SECRET=test
ALLEGRO_CS_ID=0
SYSTEM_CS_ID=0
PS_HOST=prestashop.invalid
PS_DOMAIN=prestashop.invalid
PS_USE_SSL=0
PS_APIKEY=test
OPT_URL=http://optimik.invalid
LABEL_BOGART_FRONT_GROUP=0
LABEL_BOGART_FRONT_KEY=0
LABEL_BOGART_BODY_GROUP=0
LABEL_BOGART_BODY_KEY=0
MAILER_DSN=null://null
API_TOKENS=test-client:test-token
