<html>
<head>
    <style>
        body {
            padding: 0;
            margin: 0;
            font-family: Arial, sans-serif;
            font-size: 11px;
        }

        @page
        {
            size: 60mm 100mm;
            margin: 2mm;
        }

        body
        {
            height: 100%;
            width: 100%;
        }

    </style>
</head>
<body>
<div style="width:100%; height:100%;">
    <div style="border: 1px solid #000; width:100%; height:100%; padding: 10px; box-sizing: border-box; position: relative;">
        <div style="text-align: center;">
            <div style="height: 1.4rem">
                {{ product.Codes.IndexAgata.Name }}
            </div>
            <hr/>
            {% if product.Width and product.Width.Value
                and product.Height and product.Height.Value
                and product.Depth and product.Depth.Value %}
                <div>
                    {{ product.Width }} x {{ product.Height }} x {{ product.Depth }}
                </div>
                <hr/>
            {% endif %}
            <div>
                S/N: #{{ order.id ?? random(4000, 8000) }} (#{{ product.Id }})
            </div>
            <hr/>
            <div>
                Wyprodukowano w Polsce / Manufactured in Poland /<br/>
                Vyrobeno v Polsku / Vyrobené v Poľsku
            </div>
            <hr/>
            <div>
                "MEGSTYL"<br/>
                Grzegorz Mularczyk<br/>
                Żłobnica, ul. Milenijna 10<br/>
                97-410 Kleszczów<br/>
                email: bok@megstyl.pl
            </div>
            <hr/>
            <div>
                <div style="display: flex; align-items: center; justify-content: space-around">
                    {% if product.CE %}
                        <img src="/UI/ce.jpg" height="30"/>
                    {% endif %}

                    {% if product.WEEE %}
                        <img src="/UI/weee.jpg" height="30"/>
                    {% endif %}

                    {% if product.ROHS %}
                        <img src="/UI/rohs.jpg" height="30"/>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
</body>