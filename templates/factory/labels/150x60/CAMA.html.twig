<html>
<head>
    <style>
        body {
            padding: 0;
            margin: 0;
            font-family: Arial, sans-serif;
            font-size: 11px;
        }
        .page {
            width: 568px;
            height: 227px;
            position: relative;
            padding: 3px;
            box-sizing: border-box;
        }

        .head-info
        {
            width: 100%;
            height: 208px;
            border-collapse:collapse;
        }

        .head-info tr td
        {
            /*border: 1px solid #000;*/
            border-collapse: collapse;
        }

        .details-table
        {
            padding: 0;
            margin: 0;
            width: 100%;
            font-size: 11px;
            border-collapse: collapse;
        }

        .details-table tbody tr td
        {
            padding: 2px;
            border: 1px solid #000;
            border-collapse: collapse !important;
        }

        .details-table-value
        {
            text-align: center;
        }

        .addr
        {
            text-align: center;
        }

        .addr-header
        {
            text-align: center;
        }

        .header-row
        {
            font-size: 9px;
        }

        .address
        {
            writing-mode: sideways-lr;
            text-orientation: mixed;
            text-align: center;
            font-size: 9px;
            padding: 6px;
        }

        .v
        {
            writing-mode: vertical-rl;
            text-orientation: sideways;
            transform: rotate(-180deg);
        }

        .no-break
        {
            word-break: keep-all;
        }

        .error
        {
            font-size: 12px;
            color: #fa0000;
            font-weight: bold;
            padding: 6px;
            background-color: #ffe750;
        }

        .bottom-field
        {
            border: 1px solid #000;
            padding: 2px;
            font-size: 10px;
            text-align: center;
        }

    </style>
</head>
<body>

{% set packagecount = 0 %}
{% set packageno = 0 %}

{% if product and product.Packages %}
    {% for lip in product.Packages %}
        {% set packagecount = packagecount + lip.data.Quantity %}
        {% if package.id == lip.element.id %}
            {% set packageno = loop.index %}
        {% endif %}
    {% endfor %}
{% endif %}

{% set step = min(copies, step) %}
{% set steps = (copies / step)|round(0, 'ceil') %}

{% for i in range(1, steps) %}
    <div class="page">
        <div style="width: 100%; padding-top: 8px;">
            <table class="head-info">
                <tbody>
                    <tr>
                        <td style="width: 70%; text-align: center" colspan="3">
                            <div style="font-size: 18px; font-weight: bold; text-transform: uppercase">
                                {% if product.Codes and product.Codes.IndexCama and product.Codes.IndexCama.Name  %}
                                    {{ product.Codes.IndexCama.Name }}
                                {% else %}
                                    <div class="error">
                                        Brak nazwy produktu Cama
                                    </div>
                                {% endif %}
                            </div>
                        </td>
                        <td style="text-align: center; width: 30%" rowspan="3">
                            <div>
                                <img src="{{ asset('var/assets/LOGO/cama_logo_czarne_aabb.png') }}" style="width: 90%;"/>
                            </div>
                            <div style="font-size: 9px; padding: 3px; margin: 8px 0; border: 1px solid #000;">
                                Cama Meble sp. z o.o.<br/>
                                ul. Jastrzębia 16<br/>
                                87-300 Brodnica<br/>
                                gpsr@camameble.pl
                            </div>
                            {% if product.EAN %}
                                <div style="text-align: center; display: flex; justify-content: center;">
                                    {{ code_128(product.EAN, "EAN13", 60, 1) }}
                                </div>
                                <div>
                                    {{ product.EAN }}
                                </div>
                            {% else %}
                                <div class="error">
                                    Brak kodu EAN
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <td style="width: 32%">
                            <div>
                                <table class="details-table">
                                    <tbody>
                                        <tr>
                                            <td style="width: 100px;">indeks / sku</td>
                                            <td class="details-table-value">
                                                <div style="font-weight: bold">
                                                    {% if product.Codes and product.Codes.IndexCama and product.Codes.IndexCama.Code %}
                                                        {{ product.Codes.IndexCama.Code }}
                                                    {% else %}
                                                        <div class="error">
                                                            Brak
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>nr seryjny / s/n</td>
                                            <td class="details-table-value">
                                                {% if order %}
                                                    {{ order.id }}-{{ product.id }}
                                                {% endif %}
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>długość / length</td>
                                            <td class="details-table-value">
                                                {% if package.Depth and package.Depth.Value %}
                                                    {{ (package.Depth.Value / 10)|round }}
                                                    cm
                                                {% else %}
                                                    <div class="erorr">
                                                        Brak długości paczki
                                                    </div>
                                                {% endif %}
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>szerokość / width</td>
                                            <td class="details-table-value">
                                                {% if package.Width and package.Width.Value %}
                                                    {{ (package.Width.Value / 10)|round }}
                                                    cm
                                                {% else %}
                                                    <div class="error">
                                                        Brak szerokości paczki
                                                    </div>
                                                {% endif %}
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>wysokość / height</td>
                                            <td class="details-table-value">
                                                {% if package.Height and package.Height.Value %}
                                                    {{ (package.Height.Value / 10)|round }}
                                                    cm
                                                {% else %}
                                                    <div class="error">
                                                        Brak długości paczki
                                                    </div>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </td>
                        <td style="text-align: center; width: 20%">
                            {% if product.Drawing %}
                                <img src="{{ product.Drawing }}" style="width: 80px;"/>
                            {% else %}
                                <div class="error">
                                    Brak miniaturki produktu
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <div style="text-align: center;">
                                <span style="font-size: 64px; font-weight: bold; letter-spacing: -9px;">
                                    {{ packageno }}
                                </span>
                                <span style="font-size: 48px;">
                                /{{ packagecount }}
                                </span>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2'">
                            <div style="width: 100%">
                                <div style="width: 32%; float: left; margin-right: 3%">
                                    <div style="font-size: 8px">
                                        waga / weight:
                                    </div>
                                    <div class="bottom-field">
                                        {% if package.mass %}
                                            {{ package.mass }}
                                        {% else %}
                                            <div class="error">
                                                Brak wagi paczki
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div style="width: 32%; float: left; margin-right: 3%">
                                    <div style="font-size: 8px">
                                        kubatura / volume:
                                    </div>
                                    <div class="bottom-field">
                                        {% if package.volume %}
                                            {{ package.volume }}
                                        {% else %}
                                            <div class="error">
                                                Brak objętości paczki
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div style="width: 30%; float: left;">
                                    <div style="font-size: 8px">
                                        partia / serie:
                                    </div>
                                    <div class="bottom-field">
                                        {% if order.parent %}
                                            {{ order.parent.key }}
                                        {% else %}
                                            <div class="error">
                                                Brak kodu partii
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div style="text-align: center">
                                <svg fill="#000000" width="40px" height="40px" viewBox="0 0 24 24" id="up-double-arrow" data-name="Flat Line" xmlns="http://www.w3.org/2000/svg" class="icon flat-line"><polyline id="primary" points="20 7 17 4 14 7" style="fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;"></polyline><path id="primary-2" data-name="primary" d="M10,7,7,4,4,7" style="fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;"></path><path id="primary-3" data-name="primary" d="M17,20V4M7,20V4" style="fill: none; stroke: rgb(0, 0, 0); stroke-linecap: round; stroke-linejoin: round; stroke-width: 2;"></path></svg>
                                <img src="/UI/glass.svg" height="38px"/>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
{% endfor %}
</body>
</html>
