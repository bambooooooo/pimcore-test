<html>
<head>
    <style>
        * {
            font-size: 8px;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            font-size: 9px;
        }
        .page {
            width: 568px;
            height: 227px;
            position: relative;
            border: 1px solid #000;
        }

        .head-info
        {
            width: 100%;
            height: 100%;
            border-collapse:collapse;
        }

        .head-info tr td
        {
            border: 1px solid #000;
            border-collapse: collapse;
            padding: 4px;
        }

        .addr
        {
            text-align: center;
            font-size: 8px;
        }

        .addr-header
        {
            text-align: center;
        }

        .header-row
        {
            font-size: 9px;
        }

        .address
        {
            writing-mode: sideways-lr;
            text-orientation: mixed;
            text-align: center;
            font-size: 9px;
            padding: 6px;
        }

        .v
        {
            writing-mode: vertical-rl;
            text-orientation: sideways;
            transform: rotate(-180deg);
        }

        .no-break
        {
            word-break: keep-all;
        }

        .error
        {
            font-size: 12px;
            color: #fa0000;
            font-weight: bold;
            padding: 6px;
            background-color: #ffe750;
        }

    </style>
</head>
<body>

{% set packagecount = 0 %}
{% set packageno = 0 %}

{% if product and product.Packages %}
    {% for lip in product.Packages %}
        {% set packagecount = packagecount + lip.data.Quantity %}
        {% if package.id == lip.element.id %}
            {% set packageno = loop.index %}
        {% endif %}
    {% endfor %}
{% endif %}

{% set packageCode = null %}
{% set packageBarcode = null %}

{% if package.Codes.IndexAgata and package.Codes.IndexAgata.Codes %}
    {% for lic in package.Codes.IndexAgata.Codes %}
        {% if lic.element.id == product.id %}
            {% set packageCode = lic.data.Code %}
            {% set packageBarcode = lic.data.Barcode %}
        {% endif %}
    {% endfor %}
{% elseif package.Codes.IndexAgata and package.Codes.IndexAgata.Code %}
    {% set packageCode = package.Codes.IndexAgata.Code %}
    {% set packageBarcode = package.Codes.IndexAgata.Barcode %}
{% endif %}

{% set step = min(copies, step) %}
{% set steps = (copies / step)|round(0, 'ceil') %}
{% for i in range(1, steps) %}
    <div class="page">
        <table class="head-info">
            <tbody>
            <tr style="text-align: center">
                <td colspan="2">
                    Grzegorz Mularczyk</br>
                    "MEGSTYL"</br>
                    Żłobnica, ul. Milenijna 10</br>
                    97-410 Kleszczów</br>
                    email: bok@megstyl.pl
                </td>
                <td>
                    <div style="position: relative; display: flex; align-items: center; justify-content: space-around; margin-bottom: 4px">
                        {% if package.Barcode %}
                            {{ code_128(package.Barcode ?? "111111111111", "C128", 35) }}
                        {% endif %}
                    </div>
                    <div>
                        {% if not package.Barcode %}
                            <div class="error">
                                Brak kodu kreskowego paczki
                            </div>
                        {% else %}
                            {{ package.Barcode }}
                        {% endif %}
                    </div>
                </td>
                <td>
                    <div style="font-weight: bold; font-size: 14px;">
                        {{ package.key }}
                    </div>
                    <div style="font-size: 11px; font-weight: bold;">
                        {% set oid = random(5000, 9999) %}
                        SN: {{ order.id ?? oid }}
                    </div>
                </td>
            </tr>
            <tr>
                <td rowspan="6" style="width: 5px;">
                    <div class="v">
                        <div style="font-size: 8px;">
                            {{ package.key }}
                        </div>
                    </div>
                </td>
                <td colspan="2">
                    <div style="font-size: 9px; text-align: center;">
                        {% if not product.Codes.IndexAgata %}
                            <div class="error">
                                Brak indeksu produktu Agata
                            </div>
                        {% else %}
                            {{ product.Codes.IndexAgata.Code }}
                        {% endif %}
                    </div>
                </td>
                <td>
                    <div style="font-size: 9px; text-align: center;">
                        {% if packageCode %}
                            {{ packageCode }}
                        {% else %}
                            <div class="error">
                                No Agata package code found.
                            </div>
                        {% endif %}
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="3" style="font-size: 9px; text-align: center">
                    {% if not product.Codes.IndexAgata %}
                        <div class="error">
                            Brak nazwy produktu Agata
                        </div>
                    {% else %}
                        {{ product.Codes.IndexAgata.Name }}
                    {% endif %}
                </td>
            </tr>
            <tr>
                <td rowspan="1">
                    {% if (package.Width.Value ?? 0) * (package.Height.Value ?? 0) * (package.Depth.Value ?? 0) == 0 %}
                        <div class="error">
                            Niepoprawne wymiary paczki
                        </div>
                    {% else %}
                        {{ (package.Width.Value / 10)|round }} cm x {{ (package.Height.Value / 10)|round }} cm x {{ (package.Depth.Value / 10)|round }} cm
                    {% endif %}
                </td>
                <td rowspan="1" style="font-size: 22px; text-align: center">
                    {{ packageno }}/{{ packagecount }}
                </td>
                <td rowspan="2">
                    <div style="position: relative; display: flex; align-items: center; justify-content: space-around;">
                        {% if packageBarcode %}
                            {{ code_128(packageBarcode, "EAN13", 80) }}
                        {% endif %}
                    </div>
                    <div style="margin-top: 5px; text-align: center">
                        {% if not packageBarcode %}
                            <div class="error">
                                Brak kodu kreskowego paczki Agata
                            </div>
                        {% else %}
                            {{ packageBarcode ?? "" }}
                        {% endif %}
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    {% if not package.Mass or not package.Mass.Value %}
                        <div class="error">
                            Niepoprawna waga paczki
                        </div>
                    {% else %}
                        {{ package.Mass }}
                    {% endif %}
                </td>
                <td style="text-align: center; font-weight: bold;">
                    SN:
                    {% if order %}
                        {% if order.parent is pimcore_data_object_class("Order") %}
                            {{ order.parent.key }}
                        {% else %}
                            {{ order.key }}
                        {% endif %}
                        ({{ order.id }})
                    {% else %}
                        {{ oid }}
                    {% endif %}
                </td>
            </tr>
            </tbody>
        </table>
    </div>
{% endfor %}
</body>
</html>
