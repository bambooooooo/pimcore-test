<!doctype html>
<html lang="pl" data-bs-theme="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="/static/pimcoreadmin/img/favicon/favicon-32x32.png">
    <title>PIM - Megstyl</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
</head>
<body class="d-flex align-items-center min-vh-100" style="background: #222223">
<main class="container" style="max-width: 360px">
    <div class="card shadow">
        <div class="card-body p-4">
            <div class="text-center mb-4" style="background: #222223; border-radius: 4px; padding: 12px">
                <img src="/LOGO/megstyl_logotyp.svg" height="32" alt="Megstyl">
            </div>

            {% if error %}
                <div class="alert alert-danger py-2">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post" action="{{ path('factory_login') }}">
                <div class="mb-3">
                    <label for="username" class="form-label">{{ "Username"|trans }}</label>
                    <input type="text" id="username" name="username" value="{{ last_username }}" class="form-control" autocomplete="username" required autofocus>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">{{ "Password"|trans }}</label>
                    <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="btn btn-dark w-100">{{ "Login"|trans }}</button>
            </form>

            <div class="text-center mt-3">
                <a href="{{ path('pimcore_studioui_default_index') }}" class="small">Pimcore Studio</a>
            </div>
        </div>
    </div>
</main>
</body>
</html>
