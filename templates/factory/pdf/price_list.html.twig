{% extends 'factory/layouts/print_a4.html.twig' %}

{% block content %}

    {% if not app.request.query.has('dev_hide_cover') %}
        {{ include('factory/pdf/parts/_cover.html.twig', {title: group.Name ?? group.key, subtitle: "Pricelist", image: group.Image, id: group.id }) }}
    {% endif %}

    {% if show_summary_grid %}
        {{ include('factory/pdf/pages/product_gallery.html.twig', {prods: prods, related: related, sets: sets}) }}
    {% endif %}

    {% set pageno = 2 %}

    {% if sets|length > 0 %}
        {% for s in sets %}
            {{ include("factory/pdf/pages/product_pricing.html.twig", {s: s, pageno: pageno}) }}
            {% set pageno = pageno + 1 %}
        {% endfor %}
    {% endif %}

    {% if prods|length > 0 %}
        {% for s in prods %}
            {{ include("factory/pdf/pages/product_pricing.html.twig", {s: s, pageno: pageno}) }}
            {% set pageno = pageno + 1 %}
        {% endfor %}
    {% endif %}

    {% if related|length > 0 %}
        {% for s in related %}
            {{ include("factory/pdf/pages/product_pricing.html.twig", {s: s, pageno: pageno}) }}
            {% set pageno = pageno + 1 %}
        {% endfor %}
    {% endif %}

    {% if not app.request.query.has('dev_hide_backcover') %}
        {{ include('factory/pdf/parts/_backcover.html.twig', {id: group.id}) }}
    {% endif %}

{% endblock %}