<div class="container-fluid">
    <div class="row">
        <div class="col-12" style="height: 220px; position: relative">
            <style>
                .cuboid {

                    --width: {{ (obj.Width.value / 5)|round }}px;
                    --height: {{ (obj.Height.value / 5)|round }}px;
                    --depth: {{ (obj.Depth.value / 5)|round }}px;
                    height: var(--height);
                    width: var(--width);
                    position: relative;

                {% if obj.Width.value > obj.Height.value %}
                    transform: rotate3d(0.75, 1, 0, 30deg);
                {% else %}
                    transform: rotate3d(0.75, 1, 0, 30deg) translateY(calc(-1 * (var(--height) - var(--width))));
                {% endif %}

                    transform-style: preserve-3d;
                    top: 50%;
                }

                .cuboid__side {
                    background-color: hsla(0, 0%, 100%, 0.2);
                    border: 1px solid hsl(0, 0%, 10%);
                    position: absolute;
                }

                .cuboid__side:nth-of-type(1),
                .cuboid__side:nth-of-type(2) {
                    --coefficient: -0.5;
                    height: var(--height);
                    width: var(--width);
                    transform: translate3d(0, 0, calc(var(--depth) * var(--coefficient)));
                }

                .cuboid__side:nth-of-type(2) {
                    --coefficient: 0.5;
                }

                .cuboid__side:nth-of-type(3),
                .cuboid__side:nth-of-type(4) {
                    --rotation: 90deg;
                    height: var(--height);
                    width: var(--depth);
                    left: 50%;
                    top: 50%;
                    transform: translate(-50%, -50%) rotateY(var(--rotation)) translate3d(0, 0, calc(var(--width) * -0.5));
                }

                .cuboid__side:nth-of-type(4) {
                    --rotation: -90deg;
                }

                .cuboid__side:nth-of-type(5),
                .cuboid__side:nth-of-type(6) {
                    --rotation: -90deg;
                    height: var(--depth);
                    width: var(--width);
                    left: 50%;
                    top: 50%;
                    transform: translate(-50%, -50%) rotateX(var(--rotation)) translate3d(0, 0, calc(var(--height) * -0.5));
                }

                .cuboid__side:nth-of-type(6) {
                    --rotation: 90deg;
                }

                .cuboid:nth-of-type(2) {
                    --width: 5vmin;
                    --height: 15vmin;
                    --depth: 10vmin;
                }
            </style>
            <div style="position:relative; display: flex; justify-content: center; height: 220px; margin-top:8px;">
                <div class="cuboid">
                    <div class="cuboid__side"></div>
                    <div class="cuboid__side"></div>
                    <div class="cuboid__side"></div>
                    <div class="cuboid__side"></div>
                    <div class="cuboid__side"></div>
                    <div class="cuboid__side"></div>
                </div>
            </div>
        </div>
        <div class="col-12 text-center">
            <h1>
                {{ obj.key }}
                <a target="_blank" href="/admin/login/deeplink?object_{{ obj.id }}_object">
                    <img height="40" src="/bundles/pimcoreadmin/img/flat-color-icons/input.svg"/>
                </a>
            </h1>
        </div>
        <div class="col-12 text-center mt-2 mb-2">
            <table style="width: 100%; text-align: center;">
                <tbody>
                <tr>
                    <td><img src="/bundles/pimcoreadmin/img/flat-color-icons/right_up.svg" height="22"/></td>
                    <td><img src="/bundles/pimcoreadmin/img/flat-color-icons/right.svg" height="22"/></td>
                    <td><img src="/bundles/pimcoreadmin/img/flat-color-icons/up.svg" height="22"/></td>
                </tr>
                <tr>
                    <td>
                        <strong>
                            {% if obj.Depth and obj.Depth.Value %}
                                {{ obj.Depth }}
                            {% endif %}
                        </strong>
                    </td>
                    <td>
                        <strong>
                            {% if obj.Width and obj.Width.Value %}
                                {{ obj.Width }}
                            {% endif %}
                        </strong>
                    </td>
                    <td>
                        <strong>
                            {% if obj.Height and obj.Height.Value %}
                                {{ obj.Height }}
                            {% endif %}
                        </strong>
                    </td>
                </tr>
                <tr>
                    <td>
                        {% if obj.DepthOuter and obj.DepthOuter.Value %}
                            {{ obj.DepthOuter }}
                        {% endif %}
                    </td>
                    <td>
                        {% if obj.WidthOuter and obj.WidthOuter.Value %}
                            {{ obj.WidthOuter }}
                        {% endif %}
                    </td>
                    <td>
                        {% if obj.HeightOuter and obj.HeightOuter.Value %}
                            {{ obj.HeightOuter }}
                        {% endif %}
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
        <div class="col-12 text-center mt-2 mb-2">
            {% if obj.Mass and obj.Mass.value %}
                {{ obj.Mass }}
            {% endif %}
        </div>
        <div class="containter-fluid">
            <div class="row">
                {% for req in obj.getDependencies().getFilterRequiredByPath() %}
                    {% if req.type == 'object' %}
                        <div class="col-12 mt-1">
                            <a href="{{ path("factory_tree", {id: req.id}) }}">
                                <div class="btn btn-outline-primary" style="width: 100%;">
                                    {% set prod = pimcore_object(req.id) %}
                                    {{ prod.key }}
                                    <img src="/bundles/pimcoreadmin/img/flat-color-icons/link.svg" height="22"/>
                                </div>
                            </a>
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
    </div>
</div>
