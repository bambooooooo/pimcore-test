{
  "name": "pimcore/skeleton",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "endroid/installer": true,
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "prefer-stable": true,
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "ext-dom": "*",
    "ext-simplexml": "*",
    "ext-zip": "*",
    "czproject/pdf-rotate": "^2.1",
    "deeplcom/deepl-php": "^1.11",
    "endroid/qr-code": "^6.0",
    "endroid/qr-code-bundle": "^6.0",
    "gotenberg/gotenberg-php": "^2.4",
    "picqer/php-barcode-generator": "^3.2",
    "pimcore/data-hub": "*",
    "pimcore/data-importer": "*",
    "pimcore/pimcore": "^2026.3",
    "pimcore/platform-version": "^2026.3",
    "pimcore/quill-bundle": "*",
    "pimcore/studio-backend-bundle": "*",
    "pimcore/studio-ui-bundle": "*",
    "symfony/amqp-messenger": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/flex": "^2.5",
    "symfony/http-client": "^7.4",
    "symfony/runtime": "^7.4"
  },
  "require-dev": {
    "codeception/codeception": "^5.3",
    "codeception/module-asserts": "^3.3",
    "codeception/module-symfony": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Pimcore\\Model\\DataObject\\": "var/classes/DataObject"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-create-project-cmd": "Pimcore\\Composer::postCreateProject",
    "post-install-cmd": [
      "Pimcore\\Composer::postInstall",
      "@pimcore-scripts"
    ],
    "post-update-cmd": [
      "Pimcore\\Composer::postUpdate",
      "@pimcore-scripts"
    ],
    "pimcore-scripts": [
      "Pimcore\\Composer::clearCache",
      "Pimcore\\Composer::installAssets"
    ]
  }
}
